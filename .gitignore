coverage/

# JetBrains Rider
.idea/
*.sln.ide
.idea/

# Project-specific directories
TestResults/
.claude/settings.local.json
.claude/.cache/
# Skills: the symlinks that ~/.claude/bin/workspace-skills.py generates into this
# path are machine-local and stay out. The five skills below are real directories
# owned by this repo and ship with it. The trailing /* is load-bearing: a negation
# cannot re-include anything whose parent directory is itself excluded.
.claude/skills/*
!.claude/skills/drive-hots/
!.claude/skills/drive-battledeck/
!.claude/skills/readme-screenshots/
!.claude/skills/readme-translations/
!.claude/skills/release-prep/

# Release artefacts from ./dev release
dist/

# tools/build-placement-icon.py imports build-free-icon.py, which produces bytecode.
__pycache__/
*.pyc
