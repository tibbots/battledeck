<Window x:Class="Battledeck.UI.MVVM.View.HeroPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Battledeck.UI.MVVM.View"
        xmlns:loc="clr-namespace:Battledeck.UI.MVVM"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="#1B1D24"
        BorderBrush="#313339"
        BorderThickness="1"
        Title="{loc:Str heroes.windowTitle}" Width="1200" Height="752"
        d:DataContext="{d:DesignInstance {x:Type local:HeroPickerViewModel}}">

    <!-- HEIGHT 752, calculated and not chosen: the main window measures 1340x800, a modal
         must not exceed it, and DialogBounds.Padding leaves 24 points per side.
         800 - 2*24 = 752. Before, 800 stood here - exactly the height of the main window, so no
         margin and no visible connection to what lies behind it. The value stands here only
         for the designer; it is enforced by DialogBounds.FitToMainWindow in the constructor.

         The WIDTH stays at 1200 - it sits 92 points of slack below the maximum of 1292.
         With 64-size circles at 10 spacing, that's 15 per row; whoever touches the width
         recalculates the row occupancy (see CLAUDE.md, section "Heroes").

         Only the frame remains. The selection surface itself lives in HeroPickerView.xaml, because
         since 21.08.2026 it has a second host: the HotS tab of the account dialog.

         The focus is NO LONGER set from here. FocusManager.FocusedElement binds via
         ElementName, and a UserControl brings its own namespace with it - "SearchBox" is
         no longer findable from outside. The line therefore now stands on the UserControl itself,
         where it lies in the same namespace. -->

    <!-- Esc instead of click-outside: as its own window the picker has no outside
         to click on. The X in the top right does the same thing. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <local:HeroPickerView />
</Window>
