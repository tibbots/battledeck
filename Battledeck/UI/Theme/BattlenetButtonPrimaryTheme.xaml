<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BattlenetButtonPrimaryTheme" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="#1A73E8" />
        <!-- Blue background -->
        <Setter Property="Foreground" Value="White" />
        <!-- White text -->
        <Setter Property="FontWeight" Value="DemiBold" />
        <Setter Property="FontSize" Value="16" />
        <!-- WIDTH COMES FROM THE TEXT, and this line is what makes that true. Without
             Margin the ContentPresenter swallows the Padding: the button still grew with
             its label, but with nothing beside it - the text sat on both edges, and a
             sentence like "Open the release page" looked wider than its button.
             WHY 14,0 AND NOT 10 ALL ROUND: several buttons here carry a fixed Height of
             30. Ten points top and bottom would leave the text ten, and a 16-point line
             would be clipped inside a button that looks perfectly fine. Horizontal room
             is what a label needs; the height is set where it matters. A button whose
             content is a drawing rather than text sets Padding="0" itself. -->
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Rounded corners -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3367D6" />
                            <!-- Darker blue on hover -->
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#174EA6" />
                            <!-- Even darker blue on press -->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#003F7A" />
                            <!-- Grey background when disabled -->
                            <Setter Property="Foreground" Value="#8F8F92" />
                            <!-- Grey text when disabled -->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>