<UserControl x:Class="Smurftown.UI.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:Smurftown.UI.MVVM.ViewModel"
             xmlns:loc="clr-namespace:Smurftown.UI.MVVM"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="700" d:DesignWidth="1300">
    <!-- IsRegistered belongs on EVERY view a dialog could be opened from. None opens here today,
         but the attribute otherwise only stands out exactly when someone adds one -
         with a ViewNotRegisteredException, without a compile error and without a binding warning.
         On 20.08.2026 exactly this missing attribute cost an hour. -->
    <UserControl.DataContext>
        <viewModel:SettingsViewModel />
    </UserControl.DataContext>

    <!--
        THE EXPLANATIONS ARE NOT GONE, THEY MOVED.

        Four settings used to stand under 209 words of explanation - a paragraph above each
        selection box, plus a footnote. Together they cost around 340 points of height, which
        is why this tab scrolled although it holds four controls, and they made four choices
        look like a wall of text.

        Every one of those texts is unchanged and now hangs on the info sign beside its label
        (see BattlenetToolTipTheme). What stays on screen is what CHANGES: the state of the
        chosen value ("Measured against the running client"), a warning about a path that no
        longer exists, the progress of a scan. The rule is not "short instead of long", it is
        "an explanation is read once, a state is read every time".

        The cards are the second half of that: of the four settings exactly one belongs to
        Smurftown, the other three describe Heroes of the Storm. That used to stand in the
        running text; now it stands in the structure, and the row labels got shorter for it -
        the card already says what the row is about.
    -->
    <UserControl.Resources>
        <!-- The colours of the account row - background, border, radius. A card here and a
             card there being two different greys is exactly the drift that a shared value
             prevents. -->
        <Style x:Key="SettingsCardTheme" TargetType="Border">
            <Setter Property="Background" Value="#1E1F24" />
            <Setter Property="BorderBrush" Value="#2B2D35" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Blue, and the lighter of the two: #1A73E8 is the accent of the tab underlines
             and the primary buttons, but at 12 points it stands too dark on #1E1F24 to be
             read comfortably. #62A6FF is the same blue as the offered version in the chip
             and the links in the card below - one blue for text, one for surfaces. -->
        <Style x:Key="SettingsCardTitleTheme" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62A6FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsSeparatorTheme" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#26282F" />
        </Style>

        <!-- 240 points wide, and that is measured against the longest of them: at font size
             12.5 "Sprache des Clients" is the widest label in the four languages, and the
             info sign plus its gap take another 22. Whoever adds a longer one widens this -
             a label that wraps would push its own row out of shape. -->
        <Style x:Key="SettingsLabelTheme" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F93A0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- What the current choice means. It stands BESIDE the control and not under a
             heading, because it belongs to the value that was just picked. -->
        <Style x:Key="SettingsStateTheme" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#63677A" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="430" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <Style x:Key="SettingsInfoTheme" TargetType="ContentControl"
               BasedOn="{StaticResource BattlenetInfoIconTheme}">
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A small button beside a row, for the two that only sometimes have something to
             do: scanning the drives, asking GitHub. -->
        <Style x:Key="SettingsRowButtonTheme" TargetType="Button"
               BasedOn="{StaticResource BattlenetButtonSecondaryTheme}">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </UserControl.Resources>

    <!-- The ScrollViewer stays, although after this rebuild nothing overflows any more:
         the height of a row depends on the language, and a tab that fits in three of four
         languages is not a tab that fits. It costs nothing while nothing overflows. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource BattlenetScrollViewerTheme}">
        <StackPanel Margin="20,10,20,20">

            <!-- =================================================== Smurftown ============
                 The interface language stands at the very top and in a card of its own, not
                 beside the client language, although both are called "language". It is the
                 only setting on this tab that has nothing to do with Heroes of the Storm -
                 and it is the one that whoever does not want to read the application in
                 English looks for first.

                 The two are explicitly independent: a French client with a German interface
                 is a valid state, and that is exactly why there are two settings. -->
            <Border Style="{StaticResource SettingsCardTheme}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,13,18,11">
                        <TextBlock Text="SMURFTOWN" Style="{StaticResource SettingsCardTitleTheme}" />
                        <!-- The note that there is no save button hangs here and not on a
                             row: it is true of every setting on this tab, and this is the
                             first card. -->
                        <ContentControl Style="{StaticResource SettingsInfoTheme}"
                                        ToolTip="{loc:Str settings.savedAutomatically}" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str settings.interfaceLanguage}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                            <ContentControl Style="{StaticResource SettingsInfoTheme}"
                                            ToolTip="{loc:Str settings.interfaceLanguageHint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- ItemTemplate and NOT DisplayMemberPath - see the two
                                 selection lists further below, the same trap. -->
                            <ComboBox ItemsSource="{Binding InterfaceLanguages}"
                                      Style="{StaticResource BattlenetComboBoxTheme}"
                                      SelectedValue="{Binding SelectedAppLanguage}"
                                      SelectedValuePath="Value"
                                      Width="140" Height="30" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Left" FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- =================================================== The game ============= -->
            <Border Style="{StaticResource SettingsCardTheme}">
                <StackPanel>
                    <TextBlock Text="HEROES OF THE STORM"
                               Style="{StaticResource SettingsCardTitleTheme}"
                               Margin="18,13,18,11" />
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <!-- ============================================== installation ====== -->
                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str settings.installation}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                            <ContentControl Style="{StaticResource SettingsInfoTheme}"
                                            ToolTip="{loc:Str settings.pathHint}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,11">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding HotsPaths}" SelectedItem="{Binding SelectedPath}"
                                          Style="{StaticResource BattlenetComboBoxTheme}"
                                          Width="700" Height="30" VerticalContentAlignment="Center"
                                          HorizontalAlignment="Left" FontSize="12" />
                                <!-- The full scan is an icon and no longer a labelled button: it
                                     repeats an action the app already performed by itself at
                                     startup, and next to a 700-point path box a 130-point label
                                     claimed the weight of a main action for it. The wording is not
                                     lost - settings.scanAll stands in the tooltip, and the key
                                     keeps being used, so check-texts.py stays green.

                                     The glyph comes from Segoe MDL2 Assets (E72C, "Refresh") and
                                     NOT from an asset of our own: the font ships with every
                                     Windows since 10, and the app already demands build 19041 for
                                     the OCR. FontFamily is stated explicitly - via fallback the
                                     character would be rendered by whatever font happens to carry
                                     it, and that is a different arrow on every machine.

                                     "Stop" stays a labelled button. It is the rarer of the two and
                                     appears only while a scan is running; as a second symbol it
                                     would have to be learned. -->
                                <Button Command="{Binding ScanCommand}"
                                        Visibility="{Binding ScanVisibility}"
                                        ToolTip="{loc:Str settings.scanAll}"
                                        Style="{StaticResource BattlenetButtonSecondaryTheme}"
                                        Width="30" Height="30" Margin="10,0,0,0" Padding="0">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Content="{loc:Str settings.stopScan}" Command="{Binding StopScanCommand}"
                                        Visibility="{Binding StopVisibility}"
                                        Style="{StaticResource BattlenetButtonSecondaryTheme}"
                                        Width="130" Height="30" Margin="10,0,0,0" />
                            </StackPanel>

                            <!-- A set path that points into nothing would otherwise only stand
                                 out at the next game start - and then in the middle of a run
                                 that is already under way.

                                 BOTH LINES TAKE THEIR HEIGHT ONLY WHEN THEY SAY SOMETHING. An
                                 empty TextBlock still reserves a whole line, so without the
                                 trigger this row would carry two blank lines at all times -
                                 34 points, in the state that is the normal one. Visibility is
                                 set in the style ALONE: an attribute on the element would beat
                                 the trigger, without anything reporting an error. -->
                            <TextBlock Text="{Binding PathState}" Foreground="#C8813A" FontSize="11.5"
                                       FontWeight="DemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                                       MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PathState}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ScanStatus}" Foreground="#63677A" FontSize="11"
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="840"
                                       HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanStatus}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <!-- ============================================== input speed ======= -->
                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str settings.inputSpeed}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                            <ContentControl Style="{StaticResource SettingsInfoTheme}"
                                            ToolTip="{loc:Str settings.inputSpeedHint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- ItemTemplate and NOT DisplayMemberPath: in our own ComboBox
                                 template the path does not take effect, what is shown instead is
                                 the ToString() of the record ("SpeedChoice { Value = ... }"). An
                                 explicit template takes effect in both halves - in the expanded
                                 entry via the ContentPresenter of the ComboBoxItem, in the closed
                                 box via SelectionBoxItemTemplate. -->
                            <ComboBox ItemsSource="{Binding Speeds}"
                                      Style="{StaticResource BattlenetComboBoxTheme}"
                                      SelectedValue="{Binding SelectedSpeed}"
                                      SelectedValuePath="Value"
                                      Width="140" Height="30" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Left" FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SpeedHint}"
                                       Style="{StaticResource SettingsStateTheme}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <!-- ============================================== client language ===
                         It affects the text recognition exclusively. The calibration is
                         language-independent - an English client does not shift a single
                         anchor, it only labels everything differently. The state beside the
                         box says for English that the word list is unverified: on the machine
                         it was created on, only the German text version was installed. -->
                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str settings.clientLanguage}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                            <ContentControl Style="{StaticResource SettingsInfoTheme}"
                                            ToolTip="{loc:Str settings.clientLanguageHint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Languages}"
                                      Style="{StaticResource BattlenetComboBoxTheme}"
                                      SelectedValue="{Binding SelectedLanguage}"
                                      SelectedValuePath="Value"
                                      Width="140" Height="30" VerticalContentAlignment="Center"
                                      HorizontalAlignment="Left" FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding LanguageHint}"
                                       Style="{StaticResource SettingsStateTheme}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- =================================================== About & updates ======
                 Everything here is bound to UpdateOffer, the same object the chip in the
                 header hangs on - an installation started in this card therefore shows its
                 progress up there as well.

                 THIS IS THE FIRST PLACE THAT SHOWS WHEN THE CHECK LAST RAN. The value has
                 been sitting in update.yaml since the check existed and was visible to
                 nobody; the reason for the route was reachable only as a tooltip on a button
                 that appears on one start in a hundred. -->
            <Border Style="{StaticResource SettingsCardTheme}">
                <StackPanel>
                    <TextBlock Text="{loc:Str update.section}"
                               Style="{StaticResource SettingsCardTitleTheme}"
                               Margin="18,13,18,11" />
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str update.installed}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Update.Installed}" Foreground="#C3C8D4"
                                   FontSize="13" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                    </DockPanel>
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str update.latest}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Blue only while there is something to fetch. In the quiet
                                 case this row reads "The newest one." and has no business
                                 drawing the eye. -->
                            <TextBlock Text="{Binding Update.LatestText}" FontSize="13"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C3C8D4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Update.Display}" Value="Ready">
                                                <Setter Property="Foreground" Value="#62A6FF" />
                                                <Setter Property="FontWeight" Value="DemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- The label of the first button says what the click DOES -
                                 install, or open the release page - because this build may
                                 not always replace itself. See the row below. -->
                            <Button Content="{Binding Update.PrimaryLabel}"
                                    Command="{Binding Update.PrimaryCommand}"
                                    IsEnabled="{Binding Update.PrimaryEnabled}"
                                    Visibility="{Binding Update.ActionVisibility}"
                                    Style="{StaticResource BattlenetButtonPrimaryTheme}"
                                    Height="30" Padding="14,0" FontSize="12" Margin="16,0,0,0" />
                            <Button Content="{loc:Str update.whatsNew}"
                                    Command="{Binding Update.PageCommand}"
                                    Visibility="{Binding Update.ActionVisibility}"
                                    Style="{StaticResource SettingsRowButtonTheme}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str update.lastCheck}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                            <ContentControl Style="{StaticResource SettingsInfoTheme}"
                                            ToolTip="{loc:Str update.lastCheckHint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Update.LastCheck}" Foreground="#C3C8D4"
                                       FontSize="13" VerticalAlignment="Center" />
                            <!-- It brings the daily check forward and switches nothing off -
                                 there is no setting for the check, and this button is not one
                                 either. The reasoning is in docs/self-update.md.

                                 AN ICON, LIKE THE SCAN BUTTON TWO CARDS UP, and deliberately
                                 the SAME glyph: both mean "go and look again, now" - one on
                                 the drives, one at GitHub - and the row beside each says
                                 which of the two. The wording is not lost, update.checkNow
                                 stands in the tooltip, and the key keeps being used so
                                 check-texts.py stays green.

                                 While the request runs the button is disabled rather than
                                 hidden - the secondary theme draws that state - and the value
                                 to its left says what is happening ("Asking GitHub..."). That
                                 is the difference to the scan button, which swaps itself for
                                 a Stop: a check takes a moment and cannot be called off, a
                                 scan takes minutes and can. -->
                            <Button Command="{Binding Update.CheckCommand}"
                                    IsEnabled="{Binding Update.CanCheck}"
                                    ToolTip="{loc:Str update.checkNow}"
                                    Style="{StaticResource BattlenetButtonSecondaryTheme}"
                                    Width="30" Height="30" Margin="10,0,0,0" Padding="0">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingsSeparatorTheme}" />

                    <DockPanel Margin="18,0" MinHeight="52">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="240">
                            <TextBlock Text="{loc:Str update.selfUpdate}"
                                       Style="{StaticResource SettingsLabelTheme}" />
                            <ContentControl Style="{StaticResource SettingsInfoTheme}"
                                            ToolTip="{loc:Str update.selfUpdateHint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Update.SelfUpdateText}" FontSize="13"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="420" Foreground="#C3C8D4" />
                            <!-- The folder answers the question by itself: whoever reads
                                 C:\Program Files\... here understands without further text
                                 why the application may not overwrite itself. -->
                            <TextBlock Text="{Binding Update.InstallFolder}"
                                       Style="{StaticResource SettingsStateTheme}"
                                       MaxWidth="520" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
