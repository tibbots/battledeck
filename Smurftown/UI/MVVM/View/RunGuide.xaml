<Window x:Class="Smurftown.UI.MVVM.View.RunGuide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Smurftown.UI.MVVM.View"
        xmlns:loc="clr-namespace:Smurftown.UI.MVVM"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="#23252B"
        BorderBrush="#313339"
        BorderThickness="1"
        SizeToContent="Height"
        Title="{loc:Str run.title}" Width="520"
        d:DataContext="{d:DesignInstance {x:Type local:RunGuideViewModel}}">

    <!--
        ======================================================================
        THE RUN GUIDE. It walks a human through refreshing from a client that
        is already running, and it exists because of one measured fact: the
        client has to hold the foreground, and only a human can put it there.
        The reasoning in full sits on RunGuideViewModel.
        ======================================================================

        HEIGHT IS NOT FIXED. SizeToContent="Height" and a fixed width of 520.
        The region row appears only when there is something to ask, and a
        fixed height would leave a hole the size of that row for every account
        that plays in exactly one region - which is most of them.

        520 AND NOT 440 like the region picker: the detail line under a step
        carries sentences from the run ("25 of 31 cards read", and the German
        equivalents, which are the longest of the four languages). At 440 they
        would wrap to two lines and the funnel would shift down as it went.

        NO ESCAPE BINDING, deliberately, unlike the region picker. Escape there
        cancels a question that writes nothing; here it would abort a run that
        may be halfway through a collection, and the key is one keystroke away
        from the Alt+Tab this window keeps asking for.

        NO DEFAULT BUTTON either: the single button is Cancel while the run is
        going, and a return key that aborts a minute of reading is not a
        convenience.
    -->

    <StackPanel Orientation="Vertical">
        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="24"
                   FontWeight="DemiBold" HorizontalAlignment="Left" Margin="20,20,0,0" />

        <!-- The sentence that says why a human is needed at all. It is not decoration: without
             it the window is a progress bar that inexplicably refuses to progress. -->
        <TextBlock Text="{Binding Explain}" Foreground="#8F8F92" FontSize="13"
                   TextWrapping="Wrap" Margin="20,10,20,0" />

        <Separator Background="#313339" Margin="0,18,0,0" />

        <!-- THE FUNNEL. Five steps, and the marker is a SHAPE per state rather than one shape
             in three colours: a ring while nothing has happened, a turning arc while it is
             happening, a check when it is done. Only the failure keeps a filled disc, in red.

             All of it drawn and none of it typed - the same reasoning as the three dots of the
             actions menu, whose spacing depended on whichever font was installed.

             Blue for the arc and the check, because that is the accent the whole application
             uses for "this is the app talking": the tabs, the rank highlight, the start button.
             A separate success colour would be a fourth meaning nobody asked for. -->
        <ItemsControl ItemsSource="{Binding Steps}" Margin="20,14,20,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,14" Opacity="{Binding Opacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- The marker sits on the first text line, not centred on the block:
                             with a detail line underneath, a centred marker drifts away from
                             the label it belongs to. -->
                        <Grid Grid.Column="0" Width="14" Height="14" Margin="0,3,12,0"
                              VerticalAlignment="Top">
                            <!-- Pending and failed. -->
                            <Ellipse Fill="{Binding MarkerFill}" Stroke="{Binding MarkerBrush}"
                                     StrokeThickness="2"
                                     Visibility="{Binding RingVisibility}" />

                            <!-- THE SPINNER. A ring with a gap, turned by a storyboard - not an
                                 image and not a font glyph.

                                 THE GAP IS CALCULATED, not chosen. StrokeDashArray counts in
                                 multiples of the stroke width, so the numbers below are not
                                 points: the stroke centreline has radius (14-2)/2 = 6, giving a
                                 circumference of 37.7 points, which is 18.85 units at a
                                 thickness of 2. "14 5" is 19 - one full turn with about a
                                 quarter of it missing. Change the size or the thickness and
                                 these two numbers have to be recomputed, or the gap starts
                                 drifting around the ring as it turns.

                                 IT TURNS VIA StrokeDashOffset AND NOT VIA A RotateTransform,
                                 and that is not a matter of taste. WPF freezes Freezables
                                 declared inside a template wherever it can, and animating a
                                 frozen Transform throws at runtime - the build says nothing
                                 about it. StrokeDashOffset is a plain dependency property on
                                 Shape with no Freezable anywhere near it. Sliding the dash
                                 pattern by exactly its own period (14 + 5 = 19) walks the gap
                                 once around the ring, which is the same picture with none of
                                 the risk.

                                 The animation starts on Loaded and never stops. It also runs
                                 while the element is collapsed, which is four of the five steps
                                 - animating one double on a hidden shape costs nothing
                                 measurable, and the alternative would be a trigger per state
                                 that has to be kept in step with the ViewModel. -->
                            <Ellipse Stroke="#1A73E8" StrokeThickness="2"
                                     StrokeDashArray="14 5" StrokeDashCap="Round"
                                     Visibility="{Binding SpinnerVisibility}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="StrokeDashOffset"
                                                    From="0" To="19" Duration="0:0:0.9"
                                                    RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Done. Blue and free-standing - there is no disc behind it, so
                                 the check is the whole marker and can use the full 14 points. -->
                            <Path Data="M1.5,7.5 L5.5,11.5 L12.5,3" Stroke="#1A73E8"
                                  StrokeThickness="2.2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="{Binding CheckVisibility}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="14"
                                       FontWeight="DemiBold" />
                            <!-- One line, and it is allowed to wrap: the progress sentences of
                                 the run land here, and they are written for humans, not for a
                                 fixed width. -->
                            <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Visibility="{Binding DetailVisibility}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- THE REGION QUESTION, asked here rather than in a window of its own. A second dialog
             would take the foreground in the middle of the run, and taking the foreground is
             the one thing this flow cannot survive. It is hidden whenever there is nothing to
             ask, which is the normal case: an account that plays in exactly one region has
             already answered. -->
        <StackPanel Orientation="Vertical" Visibility="{Binding RegionVisibility}"
                    Margin="20,0,20,0">
            <Separator Background="#313339" Margin="0,0,0,14" />
            <TextBlock Text="{Binding RegionQuestion}" Foreground="#8F8F92" FontSize="13"
                       FontWeight="DemiBold" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding RegionChoices}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- CommandParameter BEFORE Command, and that order is not cosmetic. WPF
                             applies attributes in document order; with Command first, the button
                             evaluates CanExecute against a parameter that is still null - and
                             RelayCommand<T> answers false for a null parameter as soon as T is a
                             value type, which an enum is. The button then comes up disabled. -->
                        <Button Style="{StaticResource BattlenetButtonPrimaryTheme}"
                                Content="{Binding Label}" Width="140" Height="34" Margin="0,0,10,0"
                                CommandParameter="{Binding Region}" Command="{Binding Command}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Separator Background="#313339" Margin="0,18,0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <!-- ONE button for two jobs - "Cancel" while it runs, "Close" when it is over.
                 There is never a moment where both would make sense, and a second, permanently
                 dead button would be noise on a window that is mostly waiting. -->
            <Button Style="{StaticResource BattlenetButtonSecondaryTheme}"
                    Content="{Binding CloseLabel}" Width="140" Height="30"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
